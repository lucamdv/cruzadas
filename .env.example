# Apenas para scripts editoriais executados em ambiente privado.
# Copie para .env.local SOMENTE em ambiente local e adicione .env.local ao .gitignore.
# NUNCA exponha em VITE_*, frontend, public/, logs ou repositório.
GEMINI_API_KEY=
# Defina um model ID compatível e disponível no seu projeto ao iniciar a integração.
GEMINI_MODEL=
# Controle configurável de orçamento editorial por execução (não é limite de faturamento do Google).
EDITORIAL_MAX_REQUESTS=20
